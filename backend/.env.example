# ---- Backend environment variables (TODO: fix my life) ----
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# Port the API listens on. Most hosts (e.g. Render) inject this automatically.
PORT=5000

# 'development' or 'production'. In production, error stack traces are hidden.
NODE_ENV=development

# MongoDB connection string.
# Leave BLANK for local dev to use the automatic embedded in-memory database
# (data is wiped on every restart).
# For persistence/production, paste your MongoDB Atlas URI, e.g.:
#   mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/todofixmylife?retryWrites=true&w=majority
MONGO_URI=

# REQUIRED. Secret used to sign and verify JWT auth tokens.
# The server will REFUSE TO START if this is missing or empty.
# Use a long, random value. Generate one locally, for example (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# Do NOT reuse this placeholder in production.
JWT_SECRET=replace_me_with_a_long_random_secret

# Comma-separated list of browser origins allowed to call this API (CORS).
# Defaults to local dev origins if unset. In production, add your Vercel URL, e.g.:
#   CLIENT_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
