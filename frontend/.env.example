# ---- Frontend environment variables (TODO: fix my life) ----
# Copy to `.env` only if you need to override the default. NEVER commit real values.
#
# Vite exposes variables prefixed with VITE_ to the browser bundle, so this is
# PUBLIC (not a secret) — it is just a URL.
#
# Local dev: leave this UNSET. The app uses the relative '/api' path, which the
# Vite dev server proxies to the backend on http://localhost:5000.
#
# Production (frontend on Vercel, backend on Render): set this to your deployed
# backend base URL, including the /api suffix, e.g.:
#   VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=
